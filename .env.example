# No subas este archivo con una clave real. Crea un archivo .env basado en este ejemplo.
OPENAI_API_KEY=tu_clave_de_openai

# Modelo OpenAI usado por el agente. Puedes reemplazarlo por otro modelo compatible.
OPENAI_MODEL=gpt-5-mini

# URL de la API de inventario inmobiliario (obligatoria).
INMOTECH_API_URL=https://tu-api-de-inventario.example/propiedades

# Nivel de detalle de los logs estructurados: DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO
